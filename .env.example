# Variables de entorno para BiblioGest v1.1
# Copia este archivo a .env y configura tus valores

# Nota: Funcionalidad de email deshabilitada en esta versión
# Para activar emails, configura un servidor SMTP compatible
# y añade las variables de entorno correspondientes

# Ejemplo para futura implementación:
# BIBLIOGEST_EMAIL_PASSWORD=tu_contraseña
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# EMAIL_FROM=tu_email@gmail.com
# EMAIL_ADMIN=admin@ejemplo.com
